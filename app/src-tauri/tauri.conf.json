{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileEpoch",
  "version": "../package.json",
  "identifier": "io.github.asiak3.fileepoch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FileEpoch",
        "width": 1200,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "publisher": "A.C.",
    "copyright": "Copyright 2026 A.C.",
    "category": "Utility",
    "shortDescription": "Browse Kopia backups through time and restore files",
    "longDescription": "FileEpoch connects to a Kopia web server, shows the versions of each backup source on a timeline and lets you browse and restore files, folders or whole versions to your computer. It only reads from the server.",
    "homepage": "https://github.com/Asiak3/FileEpoch",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish",
          "German"
        ],
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RTNCNzdENTg3NTYxQUQKUldTdFlYVllmYmZqT0tHLzVhYUhDbStKbFBpZXl3cGdseTBVZTJ5NFh6cUZSbFQ0d093VlgvTGsK",
      "endpoints": [
        "https://github.com/Asiak3/FileEpoch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
